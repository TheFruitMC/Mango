{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "license": "${license}",
    "icon": "icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "org.fruitmc.mango.MangoFabric"
        ],
        "modmenu": [
            "org.fruitmc.mango.fabric.ModMenuIntegration"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "modmenu": ">=${modmenu_version}"
    },
    "breaks": {
        "sodium": "*"
    }
}